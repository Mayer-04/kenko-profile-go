PORT=8080

AWS_REGION=us-east-1
EVENT_BUS_NAME=kenko-dev-bus
# Cola SQS de Profile (regla kenko-dev-auth-to-profile)
PROFILE_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/137696817246/kenko-dev-profile-authentication
# Credenciales AWS (recomendado: variables de entorno o ~/.aws; solo para local si hace falta)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# MongoDB root user credentials
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# MongoDB application database and user credentials
MONGO_APP_DB=kenko_eps
MONGO_APP_USER=
MONGO_APP_PASSWORD=

# Desarrollo local (Docker). Tiene prioridad si está bien formada (D9-A: replica set kenkoRs).
MONGODB_URI=

# Producción (Atlas). Se usa si MONGODB_URI está vacía o mal formada.
MONGO_ATLAS_URI=

# Relay: intervalo de sondeo (ej. 5s), lote (máx. 10) y lease de reclamo (ej. 1m)
# RELAY_POLL_INTERVAL=5s
# RELAY_BATCH_SIZE=10
# RELAY_CLAIM_LEASE=1m
LOG_LEVEL=info
