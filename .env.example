PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info

AWS_REGION=us-east-1
AWS_ACCOUNT_ID=137696817246
EVENT_BUS_NAME=kenko-dev-bus

# Cola de consumo de Profile (sección 10.1).
SQS_QUEUE_NAME=kenko-dev-profile-authentication

# Parámetros de consumo del worker (opción A de D7).
SQS_MAX_MESSAGES=10
SQS_WAIT_SECONDS=20
SQS_VISIBILITY_SECONDS=30

# MongoDB: credenciales del contenedor de Docker.
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

MONGO_APP_USERNAME=
MONGO_APP_PASSWORD=
MONGO_APP_DATABASE=kenko_eps

# Desarrollo local (Docker): primera opción si está definida y bien formada
# (mongodb:// o mongodb+srv://); si no, se usa la de Atlas (sección 8.3).
# Desde el host se necesita directConnection=true porque la réplica local
# anuncia su miembro como mongodb:27017 (nombre de la red de Docker).
# Ejemplo:
# MONGODB_URI=mongodb://usuario:clave@127.0.0.1:27017/kenko_eps?authSource=kenko_eps&directConnection=true
MONGODB_URI=

# Producción (Atlas): segunda opción.
MONGO_ATLAS_URI=

# Relay (sección 6): sondeo del outbox, lote máximo y bloqueo del reclamo.
RELAY_POLL_INTERVAL=2s
RELAY_BATCH_SIZE=10
OUTBOX_LOCK_TTL=60s

# Días que se conservan los eventos publicados antes de borrarlos (índice TTL, D6).
OUTBOX_TTL_DAYS=7
