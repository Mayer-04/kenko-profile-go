PORT=8080

AWS_REGION=us-east-1
EVENT_BUS_NAME=kenko-dev-bus
# Cola SQS de Profile (regla kenko-dev-auth-to-profile)
PROFILE_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/137696817246/kenko-dev-profile-authentication
# Credenciales AWS (recomendado: variables de entorno o ~/.aws; solo para local si hace falta)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# MongoDB root user credentials (nombres exigidos por compose.yml)
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# MongoDB application database and user credentials (nombres exigidos por compose.yml)
MONGO_APP_DATABASE=kenko_eps
MONGO_APP_USERNAME=
MONGO_APP_PASSWORD=
# Compatibilidad con config.go (lee MONGO_APP_DB primero)
MONGO_APP_DB=kenko_eps

# Desarrollo local (Docker). Tiene prioridad si está bien formada (D9-A: replica set kenkoRs).
MONGODB_URI=

# Producción (Atlas). Se usa si MONGODB_URI está vacía o mal formada.
MONGO_ATLAS_URI=

# Relay: intervalo de sondeo (ej. 5s), lote (máx. 10) y lease de reclamo (ej. 1m)
# RELAY_POLL_INTERVAL=5s
# RELAY_BATCH_SIZE=10
# RELAY_CLAIM_LEASE=1m
LOG_LEVEL=info

# Certificados (feature documents)
DOCUMENTS_BUCKET_NAME=
JWT_SECRET=

# Entorno: development por defecto. En producción usa production o prod.
# El loader acepta APP_ENV con prioridad y ENVIRONMENT como fallback.
# ENVIRONMENT=development
# APP_ENV=development

# CORS: orígenes completos separados por comas (sin `*`, sin barra final).
# En desarrollo puedes dejar estos cuatro puertos del frontend.
# Si no está definida y el entorno NO es producción, se usan estos 4 por defecto.
# Si no está definida y el entorno ES producción, no se envían headers (todo denegado).
# Al desplegar el frontend, cambia este valor a su URL real.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5000,http://localhost:8080

# Demo: siembra de citas y autorizaciones al arrancar el api (solo local)
SEED_DEMO_DATA=
DEMO_USERS_FILE=seed/demo_users.json
DEMO_EXTRA_PROFILES=7
